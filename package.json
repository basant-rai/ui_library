{
  "name": "simple_ui_elements",
  "version": "1.0.21",
  "description": "A simple UI components library for React with Tailwind CSS.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "postinstall": "node scripts/setup-script.js",
    "dev": "tsup --watch",
    "build": "tsup && mkdir -p dist/styles && cp src/styles/global.css dist/styles/ && tsc src/utils/cn.tsx --outDir dist/ --target esnext --module commonjs",
    "prepare": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "bin": {
    "setup": "./scripts/setup-script.js"
  },
  "keywords": [
    "react",
    "ui",
    "tailwind",
    "components",
    "formik",
    "react-hook-form",
    "style",
    "frontend",
    "error"
  ],
  "author": "Basant",
  "license": "ISC",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.1.3",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@types/node": "^22.15.17",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "postcss": "^8.5.2",
    "react-select": "^5.10.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.6"
  },
  "files": [
    "dist",
    "postcss.config.mjs",
    "scripts"
  ]
}
